with "geozone_lib";

project Geozone_Test is

   for Languages use ("Ada");
   for Source_Dirs use ("test");
   for Object_Dir use "obj/test";
   for Exec_Dir use "bin";
   for Main use ("test_weapon.adb");

   package Compiler is
      for Switches ("Ada") use ("-gnat95", "-g", "-O2");
   end Compiler;

   package Linker is
      for Switches ("Ada") use ("-lstdc++");
   end Linker;

end Geozone_Test;
