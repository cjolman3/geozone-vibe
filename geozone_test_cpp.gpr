project Geozone_Test_Cpp is

   for Languages use ("C++");
   for Source_Dirs use ("test_cpp", "src");
   for Object_Dir use "obj/test_cpp";
   for Exec_Dir use "bin";
   for Main use ("geozone_test.cpp");

   package Compiler is
      for Switches ("C++") use ("-std=c++14", "-g", "-O2");
   end Compiler;

   package Linker is
      for Switches ("C++") use ("-lcppunit");
   end Linker;

end Geozone_Test_Cpp;
