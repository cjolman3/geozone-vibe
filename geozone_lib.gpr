library project Geozone_Lib is

   for Languages use ("Ada", "C++");
   for Source_Dirs use ("src");
   for Object_Dir use "obj/lib";
   for Library_Dir use "lib";
   for Library_Name use "geozone";
   for Library_Kind use "static";

   package Compiler is
      for Switches ("Ada") use ("-gnat95", "-g", "-O2");
      for Switches ("C++") use ("-std=c++14", "-g", "-O2");
   end Compiler;

end Geozone_Lib;
